// Функция - Сумма НДС по ставке
// Рассчитывает сумму НДС от общей суммы «в том числе» на основании выбранного перечисления.
//
// Параметры:
//  Сумма - Число - Полная стоимость, включающая в себя НДС.
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - Выбранный вариант ставки налога.
// 
// Возвращаемое значение:
//  Число - Рассчитанная сумма НДС, округленная до копеек.
//
Функция СуммаНДСПоСтавке(Сумма, СтавкаНДС) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Сумма) Или Сумма = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ПроцентНалога = 0;
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		ПроцентНалога = 20;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		ПроцентНалога = 10;
	Иначе
		ПроцентНалога = 0;
	КонецЕсли;
	
	Если ПроцентНалога = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	СуммаНДС = Сумма * ПроцентНалога / (100 + ПроцентНалога);
	
	Возврат Окр(СуммаНДС, 2);
	
КонецФункции