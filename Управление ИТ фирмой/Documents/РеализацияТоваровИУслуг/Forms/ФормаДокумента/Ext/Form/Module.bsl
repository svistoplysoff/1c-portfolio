&НаКлиенте
Функция СуммаПоСтроке(Строка)
	
	ИсходнаяСумма = Строка.Количество * Строка.Цена;
	РазмерСкидки = ИсходнаяСумма * Строка.Скидка / 100;
	
	Возврат ИсходнаяСумма - РазмерСкидки;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииНоменклатуры(ИзмененнаяСтрока)
	
	Если ЗначениеЗаполнено(ИзмененнаяСтрока.Номенклатура) Тогда
		ИзмененнаяСтрока.СтавкаНДС = ПолучитьСтавкуНДСНаСервере(ИзмененнаяСтрока.Номенклатура);
		
		Если Объект.Ссылка.Пустая() Тогда
			РабочаяДата = ТекущаяДата();
		Иначе
			РабочаяДата = Объект.Дата;
		КонецЕсли;
		
		ИзмененнаяСтрока.Цена = ЦеныВызовСервера.ЦенаНаДату(ИзмененнаяСтрока.Номенклатура, РабочаяДата);
		ИзмененнаяСтрока.Скидка = ЦеныВызовСервера.СкидкаНаДату(ИзмененнаяСтрока.Номенклатура, РабочаяДата);
		
		ПриИзмененииЦены(ИзмененнаяСтрока);
		ПриИзмененииСкидки(ИзмененнаяСтрока);
		ПриИзмененииСтавкиНДС(ИзмененнаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКоличества(ИзмененнаяСтрока)
	
	ИзмененнаяСтрока.Сумма = СуммаПоСтроке(ИзмененнаяСтрока);
	ПриИзмененииСуммы(ИзмененнаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЦены(ИзмененнаяСтрока)
	
	ПриИзмененииКоличества(ИзмененнаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСкидки(ИзмененнаяСтрока)
	
	ПриИзмененииКоличества(ИзмененнаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСуммы(ИзмененнаяСтрока)
	
	ИзмененнаяСтрока.СуммаНДС = НДСКлиентСервер.СуммаНДСПоСтавке(ИзмененнаяСтрока.Сумма, ИзмененнаяСтрока.СтавкаНДС);
	Объект.Сумма = Объект.ТоварыИУслуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтавкиНДС(ИзмененнаяСтрока)
	
	ПриИзмененииСуммы(ИзмененнаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыИУслугиНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТоварыИУслуги.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		ПриИзмененииНоменклатуры(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

